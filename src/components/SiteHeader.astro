---
import { NAV_ITEMS } from '../lib/nav'
import type { SiteSection } from '../lib/nav'

interface Props {
  active: SiteSection
}

const { active } = Astro.props
const navLinkClass =
  'flex h-full items-center text-button font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink'
---

<header
  id="site-header"
  class="site-header sticky top-0 z-30 border-b border-line bg-paper/95 backdrop-blur-md"
>
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-wrap items-center gap-x-4 px-4 sm:h-14 sm:flex-nowrap sm:gap-x-8 sm:px-6 lg:gap-x-10 lg:px-10 xl:px-[100px]"
  >
    <a
      href="../simulator/"
      data-section="simulator"
      class="order-1 flex h-11 shrink-0 items-center text-[22px] font-medium leading-none tracking-[-0.03em] sm:h-full"
      aria-label="WoS Util home"
    >
      WoS Util
    </a>

    <nav
      class="relative order-3 flex h-10 w-full items-center gap-6 border-t border-line sm:order-2 sm:h-full sm:w-auto sm:flex-1 sm:border-t-0"
      aria-label="Sections"
    >
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            data-section={item.section}
            aria-current={item.section === active ? 'page' : undefined}
            class:list={[
              navLinkClass,
              item.section === active ? 'text-ink' : 'text-ink-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <span
        data-nav-indicator
        class="pointer-events-none absolute bottom-0 left-0 z-10 h-0.5 bg-ink"
        aria-hidden="true"></span>
    </nav>

    <div
      class="actions order-2 ml-auto flex shrink-0 items-center gap-2 sm:order-3 sm:gap-3"
      data-animated="true"
      data-share-hidden="true"
    >
      <div class="actions-main flex items-center gap-2 sm:gap-3">
        <p
          id="utc-clock"
          class="hidden font-mono text-micro tabular-nums text-ink-muted sm:block"
          aria-label="Current UTC time"
        >
          UTC: --:--:--
        </p>
        <span class="hidden h-5 w-px bg-line sm:block" aria-hidden="true"></span>
        <button
          type="button"
          id="theme-toggle"
          aria-label="Switch theme"
          title="Switch theme"
          aria-pressed="false"
          class="flex size-9 cursor-pointer items-center justify-center rounded-sm border border-line bg-transparent text-ink transition-colors hover:border-line-strong hover:bg-tint/50 active:bg-tint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        >
          <svg
            class="theme-icon-moon"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M13.5 9.6A5.9 5.9 0 0 1 6.4 2.5a5.9 5.9 0 1 0 7.1 7.1Z"></path>
          </svg>
          <svg
            class="theme-icon-sun"
            viewBox="0 0 16 16"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="8" cy="8" r="3"></circle>
            <path
              d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M12.95 3.05l-1.13 1.13M4.18 11.82l-1.13 1.13"
            ></path>
          </svg>
        </button>
      </div>

      <div class="share-slot shrink-0">
        <button
          type="button"
          id="share-button"
          title="Copy share link with your rally setup"
          aria-label="Copy share link with your rally setup"
          tabindex="-1"
          aria-hidden="true"
          class="share-button cursor-pointer rounded-sm bg-invert px-4 py-2 text-button font-medium text-invert-fg hover:opacity-85 active:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        >
          Share
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  ;(() => {
    const actions = document.querySelector('#site-header .actions')
    const slot = actions?.querySelector('.share-slot')
    if (!actions || !slot) return
    const gap = Number.parseFloat(getComputedStyle(actions).columnGap) || 0
    actions.style.setProperty('--share-shift', `${slot.offsetWidth + gap}px`)

    const page = document.getElementById('app')?.dataset.page
    if (page === 'countdown') {
      try {
        sessionStorage.removeItem('wosutil:share-exit')
      } catch {
        // Storage unavailable: skip.
      }
      return
    }
    if (page !== 'simulator') return

    try {
      const raw = sessionStorage.getItem('wosutil:share-exit')
      if (!raw) return
      sessionStorage.removeItem('wosutil:share-exit')
      const at = Number.parseInt(raw, 10)
      if (!Number.isFinite(at) || Date.now() - at >= 15_000) return
      actions.removeAttribute('data-share-hidden')
      actions.setAttribute('data-share-exit', 'true')
    } catch {
      // Storage unavailable: skip the exit animation.
    }
  })()
</script>
