---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="WoS Util · Page not found"
  description="The requested page does not exist. Redirecting to the WoS Util battle reports archive."
  noindex
>
  <main
    class="mx-auto flex min-h-dvh w-full max-w-[34rem] flex-col items-center justify-center gap-3 px-4 text-center"
  >
    <h1 class="text-h4 font-medium tracking-[-0.01em]">Page not found</h1>
    <p class="text-p3 text-ink-muted">
      Taking you to the <a class="underline" href="/reports/">battle reports archive</a>.
    </p>
  </main>
  <script is:inline>
    window.location.replace('/reports/')
  </script>
</BaseLayout>
