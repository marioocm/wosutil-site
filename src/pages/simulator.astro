---
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout
  title="WoS Util · Battle Simulator"
  description="WoS Util battle simulator for Whiteout Survival, in development."
  active="simulator"
>
  <main
    class="mx-auto flex w-full max-w-[1440px] flex-1 items-center justify-center px-4 py-16 sm:px-6 lg:px-10 xl:px-[100px]"
  >
    <div class="flex max-w-[34rem] flex-col gap-2 text-center">
      <h1 class="text-h4 font-medium tracking-[-0.01em]">Battle simulator</h1>
      <p class="text-p3 text-ink-muted">In development.</p>
    </div>
  </main>
</SiteLayout>
