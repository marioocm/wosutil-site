---
import AppLayout from '../layouts/AppLayout.astro'
import '../../src/styles/app.css'
---

<AppLayout title="WoS Util" description="WoS Util desktop automation console.">
  <header class="app-header">
    <div class="app-header-inner app-header-inner--nav-only">
      <nav class="app-nav" aria-label="Sections">
        <a href="#instances" data-section="instances" aria-current="page">Instances</a>
        <a href="#profiles" data-section="profiles">Profiles</a>
        <a href="#preferences" data-section="preferences">Preferences</a>
        <a href="#log" data-section="log">Log</a>
        <span class="app-nav-indicator" data-nav-indicator aria-hidden="true"></span>
      </nav>
    </div>
  </header>

  <main class="app-main">
    <div class="app-content">
      <section id="view-instances" class="app-view" aria-label="Instances">
        <section class="app-card" aria-labelledby="instances-title">
          <div class="app-card-head app-card-head--center">
            <h1 id="instances-title" class="text-h4">Instances</h1>
            <div class="app-actions">
              <label id="limit-field" class="app-inline-field" title="Maximum number of emulator instances kept open at the same time">
                <span>Max open instances</span>
                <input id="limit" class="app-input app-input--number" type="number" min="1" max="20" step="1" />
              </label>
              <button id="refresh" class="app-button" type="button">Refresh</button>
              <button id="start" class="app-button app-button--primary" type="button">Start tool</button>
              <button id="stop" class="app-button app-button--outline" type="button" hidden>Stop tool</button>
            </div>
          </div>

          <ul id="instances" class="app-list" aria-label="Emulator instances"></ul>
          <p id="empty" class="app-empty" hidden>No emulator instances detected.</p>
        </section>
      </section>

      <section id="view-profiles" class="app-view" aria-label="Profiles" hidden>
        <section class="app-card" aria-labelledby="profiles-title">
          <div class="app-card-head">
            <div>
              <h1 id="profiles-title" class="text-h4">Profiles</h1>
              <p class="app-muted">Choose a profile, tick its tasks and save.</p>
            </div>
            <div class="app-actions">
              <select id="profile-select" class="app-select" aria-label="Profile"></select>
              <button id="profile-new" class="app-button" type="button">New</button>
              <button id="profile-save" class="app-button app-button--primary" type="button">Save</button>
              <button id="profile-delete" class="app-button app-button--outline" type="button">Delete</button>
            </div>
          </div>
          <ul id="profile-tasks" class="app-check-list" aria-label="Profile tasks"></ul>
        </section>
      </section>

      <section id="view-preferences" class="app-view" aria-label="Preferences" hidden>
        <form id="preferences-form" class="app-stack" novalidate>
          <section class="app-card app-collapse" aria-labelledby="prefs-emulator-title">
            <div class="app-card-head app-collapse-head">
              <h2 id="prefs-emulator-title" class="text-p1 font-medium">Emulator</h2>
              <button type="button" class="app-collapse-toggle" aria-expanded="true" aria-controls="prefs-emulator-content" aria-label="Collapse Emulator" title="Collapse Emulator" data-section-title="Emulator">
                <svg class="app-collapse-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 6 4 4 4-4"></path>
                </svg>
              </button>
            </div>
            <div id="prefs-emulator-content" class="app-collapse-content" data-expanded="true">
              <div class="app-collapse-inner">
                <div class="app-collapse-body">
                  <p class="app-muted">The tool controls the active emulator. Stop the tool before switching it.</p>
                  <div class="app-grid-2">
                    <label class="app-field">
                      <span>Active emulator</span>
                      <select id="emulator-active" class="app-select"></select>
                    </label>
                    <label class="app-field">
                      <span>Configure paths for</span>
                      <select id="paths-emulator" class="app-select"></select>
                    </label>
                  </div>
                  <div id="paths-fields" class="app-stack-sm"></div>
                </div>
              </div>
            </div>
          </section>

          <section class="app-card app-collapse" aria-labelledby="prefs-priorities-title">
            <div class="app-card-head app-collapse-head">
              <h2 id="prefs-priorities-title" class="text-p1 font-medium">Task priorities</h2>
              <button type="button" class="app-collapse-toggle" aria-expanded="true" aria-controls="prefs-priorities-content" aria-label="Collapse Task priorities" title="Collapse Task priorities" data-section-title="Task priorities">
                <svg class="app-collapse-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 6 4 4 4-4"></path>
                </svg>
              </button>
            </div>
            <div id="prefs-priorities-content" class="app-collapse-content" data-expanded="true">
              <div class="app-collapse-inner">
                <div class="app-collapse-body">
                  <p class="app-muted">Top runs first.</p>
                  <ol id="priority-list" class="app-priority-list"></ol>
                </div>
              </div>
            </div>
          </section>

          <section class="app-card app-collapse" aria-labelledby="prefs-bear-title">
            <div class="app-card-head app-collapse-head">
              <h2 id="prefs-bear-title" class="text-p1 font-medium">Bear</h2>
              <button type="button" class="app-collapse-toggle" aria-expanded="true" aria-controls="prefs-bear-content" aria-label="Collapse Bear" title="Collapse Bear" data-section-title="Bear">
                <svg class="app-collapse-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 6 4 4 4-4"></path>
                </svg>
              </button>
            </div>
            <div id="prefs-bear-content" class="app-collapse-content" data-expanded="true">
              <div class="app-collapse-inner">
                <div class="app-collapse-body">
                  <div class="app-march-field">
                    <span>Bear rally call march</span>
                    <div id="bear-call-marches" class="app-march-picker" role="radiogroup" aria-label="Bear rally call march"></div>
                  </div>
                  <p class="app-muted">Marches used to join the bear trap rallies.</p>
                  <div id="bear-marches" class="app-stack-sm"></div>
                </div>
              </div>
            </div>
          </section>

          <section class="app-card app-collapse" aria-labelledby="prefs-resources-title">
            <div class="app-card-head app-collapse-head">
              <h2 id="prefs-resources-title" class="text-p1 font-medium">Resources</h2>
              <button type="button" class="app-collapse-toggle" aria-expanded="true" aria-controls="prefs-resources-content" aria-label="Collapse Resources" title="Collapse Resources" data-section-title="Resources">
                <svg class="app-collapse-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 6 4 4 4-4"></path>
                </svg>
              </button>
            </div>
            <div id="prefs-resources-content" class="app-collapse-content" data-expanded="true">
              <div class="app-collapse-inner">
                <div class="app-collapse-body">
                  <div class="app-march-field">
                    <span>Kill beasts march</span>
                    <div id="kill-beast-marches" class="app-march-picker" role="radiogroup" aria-label="Kill beasts march"></div>
                  </div>
                  <div class="app-grid-3">
                    <label class="app-field">
                      <span>Ox gathering</span>
                      <select id="gather" class="app-select"></select>
                    </label>
                    <label class="app-field">
                      <span>Intel</span>
                      <select id="intel" class="app-select"></select>
                    </label>
                    <label class="app-field">
                      <span>Mystery shop</span>
                      <select id="mystery-shop" class="app-select"></select>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="app-card app-collapse" aria-labelledby="prefs-behavior-title">
            <div class="app-card-head app-collapse-head">
              <h2 id="prefs-behavior-title" class="text-p1 font-medium">Behavior</h2>
              <button type="button" class="app-collapse-toggle" aria-expanded="true" aria-controls="prefs-behavior-content" aria-label="Collapse Behavior" title="Collapse Behavior" data-section-title="Behavior">
                <svg class="app-collapse-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 6 4 4 4-4"></path>
                </svg>
              </button>
            </div>
            <div id="prefs-behavior-content" class="app-collapse-content" data-expanded="true">
              <div class="app-collapse-inner">
                <div class="app-collapse-body">
                  <label class="app-check-row">
                    <input id="remember-schedule" class="app-check" type="checkbox" />
                    <span>Remember the task schedule between sessions</span>
                  </label>
                  <label class="app-check-row">
                    <input id="start-minimized" class="app-check" type="checkbox" />
                    <span>Start emulators minimized</span>
                  </label>
                  <label class="app-check-row">
                    <input id="debug-mode" class="app-check" type="checkbox" />
                    <span>Debug mode (verbose logs and OCR captures)</span>
                  </label>
                </div>
              </div>
            </div>
          </section>

          <button id="preferences-save" class="app-button app-button--primary app-save-button" type="submit">Save preferences</button>
        </form>
      </section>

      <section id="view-log" class="app-view" aria-label="Log" hidden>
        <section class="app-card" aria-labelledby="log-title">
          <div class="app-card-head">
            <h2 id="log-title" class="text-p1 font-medium tracking-[-0.01em]">Log</h2>
          </div>
          <div id="log" class="app-log" role="log" aria-live="polite"></div>
        </section>
      </section>
    </div>
  </main>

  <dialog id="dialog" class="app-dialog">
    <div class="app-dialog-body">
      <h2 id="dialog-title" class="text-p1 font-medium"></h2>
      <p id="dialog-text" class="app-dialog-text"></p>
      <label id="dialog-input-wrap" class="app-field" hidden>
        <span id="dialog-input-label"></span>
        <input id="dialog-input" class="app-input" type="text" />
      </label>
      <div id="dialog-actions" class="app-dialog-actions"></div>
    </div>
  </dialog>

  <div id="task-tooltip" class="app-tasktip" role="tooltip" hidden>
    <ol id="task-tooltip-list" class="app-tasktip-list"></ol>
  </div>

  <template id="instance-template">
    <li class="app-row-slot">
      <div class="app-row-clip">
        <div class="app-row">
          <input class="app-check" type="checkbox" />
          <span class="app-row-name"></span>
          <div class="app-row-profile-cell">
            <select class="app-select app-row-profile" aria-label="Profile"></select>
            <span class="app-row-profile-name" hidden></span>
          </div>
          <span class="app-row-status"></span>
          <button class="app-info" type="button" aria-describedby="task-tooltip" hidden>
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
              <circle cx="8" cy="8" r="6.4"></circle>
              <path d="M8 7.1v3.9"></path>
              <path d="M8 4.9v.2"></path>
            </svg>
          </button>
        </div>
      </div>
    </li>
  </template>

  <template id="profile-task-template">
    <li class="app-check-row">
      <label class="app-check-label">
        <input class="app-check" type="checkbox" />
        <span class="app-task-name"></span>
      </label>
      <span class="app-task-priority"></span>
    </li>
  </template>

  <script>
    import { initApp } from '../../src/scripts/app/index'

    initApp()
  </script>
</AppLayout>
