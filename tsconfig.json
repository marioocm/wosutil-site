{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "src-app/**/*", "astro.config.ts", "astro.app.config.ts"],
  "exclude": ["dist"]
}
